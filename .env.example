# Copy this file to .env and add your Gemini key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local model settings. The first use downloads model weights.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
KOKORO_VOICE_EN=af_heart
KOKORO_VOICE_HI=hf_alpha

MEETMIND_DATA_DIR=data
MEETMIND_UPLOAD_DIR=uploads
MEETMIND_GENERATED_DIR=generated

